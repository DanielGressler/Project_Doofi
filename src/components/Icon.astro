---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;
const paths: Record<string, string> = {
  bag: "M6 7h12l2 14H4L6 7ZM9 7V5a3 3 0 0 1 6 0v2",
  arrow: "M4 12h16m-6-6 6 6-6 6",
  pin: "M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  clock: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM12 7v5l3 2",
  check: "m5 12 4 4L19 6",
  grid: "M3 3h7v7H3V3Zm11 0h7v7h-7V3ZM3 14h7v7H3v-7Zm11 0h7v7h-7v-7Z",
  store: "M3 10h18L19 3H5l-2 7ZM5 10v11h14V10M9 21v-7h6v7",
  user: "M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21v-2a8 8 0 0 1 16 0v2",
  refresh:
    "M20 7v5h-5M4 17v-5h5M5 7a8 8 0 0 1 13-2l2 7M4 12l2 7a8 8 0 0 0 13-2",
  truck:
    "M2 5h13v12H2V5Zm13 5h4l3 4v3h-7M8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm12 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z",
  logout: "M9 4H4v16h5m6-13 5 5-5 5m-7-5h12",
