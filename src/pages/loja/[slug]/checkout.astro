---
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { getStore, getProducts } from "../../../lib/catalog";
import { money } from "../../../lib/types";
import { publicProduct } from "../../../lib/public-data";
let store;
try {
  store = await getStore(env.DB, Astro.params.slug!);
} catch {
  return Astro.redirect("/404");
}
const products = (await getProducts(env.DB, store.id)).map(publicProduct);
---

<Layout title="Dados e entrega" slug={store.slug} appearance={store}>
  <div
    id="checkout-app"
    class="wrap page-wrap checkout-compact"
    data-slug={store.slug}
    data-products={JSON.stringify(products)}
    data-store={JSON.stringify({
      delivery_fee: store.delivery_fee,
      is_open: store.is_open,
    })}
  >
    <a class="back-link" href={`/loja/${store.slug}/carrinho`}>
      ← Revisar carrinho
    </a>
    <ol class="checkout-steps" aria-label="Etapas do pedido">
      <li>
        <a href={`/loja/${store.slug}/carrinho`}>1. Carrinho</a>
      </li>
      <li aria-current="step">2. Dados e entrega</li>
      <li>3. Acompanhamento</li>
    </ol>
    <div class="page-heading">
      <div>
        <h1>
          Dados para envio<span class="accent">.</span>
        </h1>
        <p>{store.title} · Sem conta ou senha. Use dados fictícios.</p>
      </div>
    </div>
    <div id="checkout-empty" class="empty-state" hidden>
      <h2>Seu carrinho está vazio</h2>
      <a href={`/loja/${store.slug}`} class="button button-primary">
        Explorar cardápio
      </a>
    </div>
    <aside
      id="checkout-recovery"
      class="notice"
      hidden
      aria-label="Estado do envio"
    >
      <p id="recovery-message"></p>
      <a id="recovery-link" class="inline-link" hidden>
        Abrir acompanhamento do pedido →
      </a>
      <button id="reset-checkout" type="button" class="button button-quiet">
        Descartar dados e iniciar outro pedido
      </button>
      <p class="small">
        Se uma resposta se perdeu, o pedido pode já ter sido criado. Descartar
        estes dados não cancela pedidos.
      </p>
    </aside>
    <form id="checkout-form" class="checkout-layout">
      <div class="checkout-fields">
        <section class="card">
          <h2>Quem vai receber?</h2>
          <p class="small muted">
            Use um nome com Teste ou Exemplo, telefone com DDD 00 e e-mail
            @exemplo.invalid. Dados reais são bloqueados neste protótipo.
          </p>
          <div class="form-grid contact-grid">
            <label class="field">
              <span>Nome fictício</span>
              <input
                name="name"
                data-synthetic="name"
                value="Cliente Exemplo"
                required
                minlength="2"
                maxlength="80"
                autocomplete="off"
              />
            </label>
            <label class="field">
              <span>Telefone fictício</span>
              <input
                name="phone"
                data-synthetic="phone"
                type="tel"
                value="(00) 00000-0000"
                required
                minlength="3"
                maxlength="40"
                autocomplete="off"
              />
            </label>
            <label class="field">
              <span>E-mail fictício</span>
              <input
                name="email"
                data-synthetic="email"
                inputmode="email"
                value="cliente@exemplo.invalid"
                required
                minlength="3"
                maxlength="120"
                autocomplete="off"
              />
            </label>
          </div>
        </section>
        <section class="card">
          <h2>Como prefere receber?</h2>
          <fieldset>
            <legend class="sr-only">Modalidade de entrega</legend>
            <div class="choice-list compact-choices">
              <label class="choice">
                <input type="radio" name="fulfillment" value="PICKUP" checked />
                <span>
                  <strong>Vou retirar · Grátis</strong>
                  <small>{store.pickup_address}</small>
                </span>
              </label>
              {store.has_own_delivery === 1 && (
                <label class="choice">
                  <input type="radio" name="fulfillment" value="FIXED" />
                  <span>
                    <strong>
                      Entrega da loja · {money(store.delivery_fee)}
                    </strong>
                    <small>Nos bairros atendidos.</small>
                  </span>
                </label>
              )}
              <label class="choice">
                <input type="radio" name="fulfillment" value="QUOTE" />
                <span>
                  <strong>Combinar entrega com a loja</strong>
                  <small>Você aprova o frete antes de fechar o total.</small>
                </span>
              </label>
            </div>
          </fieldset>
          <div id="address-fields" class="form-grid detail-section" hidden>
            <label class="field full">
              <span>Endereço fictício e número</span>
              <input
                name="address"
                value="Rua das Flores, 10"
                minlength="5"
                maxlength="160"
                autocomplete="off"
              />
            </label>
            <label class="field">
              <span>Bairro atendido</span>
              <select name="neighborhood">
                {store.neighborhoods.split(",").map((n) => (
                  <option value={n.trim()}>{n.trim()}</option>
                ))}
              </select>
            </label>
            <label class="field">
              <span>CEP fictício</span>
              <input
                name="postalCode"
                value="00000-000"
                inputmode="numeric"
                pattern="[0-9]{5}-?[0-9]{3}"
                maxlength="9"
                autocomplete="off"
              />
            </label>
          </div>
        </section>
        <details class="card optional-note">
          <summary>Adicionar observação (opcional)</summary>
          <label class="field">
            <span>Alguma observação?</span>
            <textarea
              name="note"
              maxlength="300"
              placeholder="Ex.: vou retirar com minha sacola."
            ></textarea>
          </label>
        </details>
      </div>
      <aside class="card summary">
        <h2>Finalizar pedido</h2>
        <details class="checkout-review">
          <summary>Ver itens do carrinho</summary>
          <ul id="checkout-items" class="summary-list"></ul>
          <a class="inline-link" href={`/loja/${store.slug}/carrinho`}>
            Alterar itens
          </a>
        </details>
        <div class="field payment-choice">
          <label for="checkout-payment">Pagamento de demonstração</label>
          <select id="checkout-payment" name="payment">
            <option value="PIX_SIMULATED">Simular Pix</option>
            <option value="ON_FULFILLMENT_SIMULATED">
              Simular na retirada ou entrega
            </option>
          </select>
        </div>
        <div class="total-row">
          <span>Produtos</span>
          <strong id="checkout-subtotal"></strong>
        </div>
        <div class="total-row">
          <span>Entrega</span>
          <strong id="checkout-fee"></strong>
        </div>
        <div class="total-row grand">
          <span>Total</span>
          <strong id="checkout-total"></strong>
        </div>
        <p id="quote-notice" class="notice" hidden>
          O total fica em aberto até você aceitar o frete. Nenhum pagamento
          antes do aceite da loja.
        </p>
        <label class="checkbox">
          <input name="consent" type="checkbox" required />
          <span>
            Confirmo que uso apenas dados fictícios e entendo que este pedido é
            uma simulação, sem compra ou pagamento real.{" "}
            <a
              class="inline-link"
              href="/politicas"
              target="_blank"
              rel="noopener"
            >
              Condições da demonstração
            </a>
            .
          </span>
        </label>
        <button
          class="button button-primary button-full"
          type="submit"
          id="submit-order"
        >
          Enviar pedido de teste <Icon name="arrow" size={18} />
        </button>
        <p id="feedback" class="feedback" role="alert" aria-live="polite"></p>
        <p class="small muted">
          Valores recalculados pelo servidor. Guarde o link de acompanhamento
          após o envio.
        </p>
      </aside>
    </form>
  </div>
</Layout>
<script>
  import "../../../scripts/checkout";
  import "../../../scripts/synthetic-fields";
</script>
