---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { env } from "cloudflare:workers";
import type { Store } from "../../lib/types";
import {
  palettes,
  fonts,
  layouts,
  appearanceStyles,
} from "../../lib/appearance";
const store = (await env.DB.prepare("SELECT * FROM stores WHERE id=?")
  .bind(Astro.locals.session!.store_id)
  .first<Store>())!;
---

<PanelLayout title="Minha loja" active="store">
  <div class="page-heading">
    <div>
      <div class="eyebrow">SEU JEITO DE ATENDER</div>
      <h1>
        A casa é sua<span class="accent">.</span>
      </h1>
      <p>Organize as informações e a entrega da sua loja fictícia.</p>
    </div>
  </div>
  <form
    id="store-form"
    data-version={store.version}
    data-banner-id={store.banner_id ?? ""}
    class="card"
  >
    <div class="form-grid">
      <label class="field">
        <span>Nome da loja</span>
        <input
          name="title"
          value={store.title}
          minlength="2"
          maxlength="80"
          required
        />
      </label>
      <label class="field">
        <span>Contato comercial fictício</span>
        <input
          name="contact"
          value={store.contact}
          minlength="4"
          maxlength="80"
          required
        />
      </label>
      <label class="field full">
        <span>Descrição</span>
        <textarea
          name="description"
          minlength="2"
          maxlength="300"
          required
        >{store.description}</textarea>
      </label>
      <label class="field full">
        <span>Horários informados ao comprador</span>
        <input
          name="hours"
          value={store.hours}
          minlength="3"
          maxlength="120"
          required
        />
        <small>
          A abertura é controlada pelo botão de disponibilidade abaixo. A P1 não
          interpreta automaticamente o texto de horários.
        </small>
      </label>
      <label class="field full">
        <span>Endereço fictício de retirada</span>
        <input
          name="pickup_address"
          value={store.pickup_address}
          minlength="4"
          maxlength="160"
          required
        />
      </label>
      <label class="checkbox full">
        <input
          type="checkbox"
          name="has_own_delivery"
          checked={!!store.has_own_delivery}
        />
        <span>Possui entregador próprio</span>
      </label>
      <label
        class="field"
        id="fixed-delivery-field"
        hidden={!store.has_own_delivery}
      >
        <span>Taxa fixa de entrega (R$)</span>
        <input
          type="number"
          name="delivery_fee"
          value={(store.delivery_fee / 100).toFixed(2)}
          min="0"
          max="1000"
          step="0.01"
          required={!!store.has_own_delivery}
        />
      </label>
      <label class="field">
        <span>Bairros atendidos</span>
        <input
          name="neighborhoods"
          value={store.neighborhoods}
          minlength="2"
          maxlength="300"
          required
        />
        <small>
          Separe os bairros por vírgulas. Sem mapas ou geolocalização.
        </small>
      </label>
    </div>
    <fieldset class="appearance-editor">
      <legend>Personalização da loja</legend>
      <p>
        Personalize a página inteira: cabeçalho, banner, filtros, produtos,
        carrinho e rodapé. O mesmo visual acompanha o checkout e o pedido.
      </p>
      <div class="form-grid">
        <label class="field">
          <span>Paleta de cores</span>
          <select name="palette" aria-label="Paleta de cores">
            {Object.entries(palettes).map(([key, value]) => (
              <option value={key} selected={store.palette === key}>
                {value.label}
              </option>
            ))}
          </select>
        </label>
        <label class="field">
          <span>Estilo das fontes</span>
          <select name="font" aria-label="Estilo das fontes">
            {Object.entries(fonts).map(([key, value]) => (
              <option value={key} selected={store.font === key}>
                {value.label}
              </option>
            ))}
          </select>
        </label>
        <label class="field full">
          <span>Layout da página</span>
          <select name="layout" aria-label="Layout da página">
            {Object.entries(layouts).map(([key, value]) => (
              <option value={key} selected={store.layout === key}>
                {value.label} — {value.description}
              </option>
            ))}
          </select>
          <small>
            O layout muda a apresentação da loja inteira. Cores e fontes podem
            ser escolhidas separadamente.
          </small>
        </label>
        <div
          class="full appearance-preview store-theme"
          id="appearance-preview"
          data-layout={store.layout}
          style={appearanceStyles(store)}
          aria-label="Prévia da página da loja"
        >
          <div class="appearance-preview-header">
            <strong>{store.title}</strong>
            <span>Seu pedido</span>
          </div>
          <div class="appearance-preview-hero">
            <h2>Sua loja, do seu jeito</h2>
            <p>Banner, cores e fontes em toda a página.</p>
            <span class="preview-button">Conheça o cardápio</span>
          </div>
          <div class="appearance-preview-layout">
            <div class="appearance-preview-products">
              <div class="appearance-preview-card">
                <h3>Produto da casa</h3>
                <p>Descrição com a fonte escolhida.</p>
                <strong>R$ 24,00</strong>
              </div>
              <div class="appearance-preview-card">
                <h3>Combo especial</h3>
                <p>Seu cardápio organizado.</p>
                <strong>R$ 29,00</strong>
              </div>
            </div>
            <div class="appearance-preview-card">
              <h3>Seu pedido</h3>
              <p>O carrinho também segue seu visual.</p>
            </div>
          </div>
          <div class="appearance-preview-footer">
            Contato e informações da loja
          </div>
        </div>
        <label class="field full">
          <span>Banner da loja (opcional)</span>
          <input type="file" name="banner" accept="image/jpeg,image/png" />
          <small>
            JPG ou PNG de até 2 MB e 4 megapixels. Ajustamos para 1600 × 600
            pixels com recorte central. Prefira uma imagem horizontal.
          </small>
        </label>
        {store.banner_id && (
          <div class="full">
            <img
              class="banner-preview"
              src={`/media/${store.banner_id}`}
              alt="Banner atual da loja"
              width="1600"
              height="600"
            />
            <label class="checkbox">
              <input type="checkbox" name="remove_banner" />
              <span>Remover banner e voltar à ilustração</span>
            </label>
          </div>
        )}
      </div>
    </fieldset>
    <label class="checkbox">
      <input type="checkbox" name="is_open" checked={!!store.is_open} />
      <span>Loja aberta para novos pedidos de teste</span>
    </label>
    <button type="submit" class="button button-primary">
      Salvar configurações
    </button>
    <p id="feedback" class="feedback" role="alert" aria-live="polite"></p>
  </form>
</PanelLayout>
<script>
  import { $, api, busy, feedback } from "../../scripts/browser";
  import { upload } from "../../scripts/uploads";
  import { appearanceStyles } from "../../lib/appearance";
  import type { StoreAppearance } from "../../lib/types";
  const form = $<HTMLFormElement>("#store-form");
  const own = $<HTMLInputElement>('[name="has_own_delivery"]', form),
    fee = $<HTMLInputElement>('[name="delivery_fee"]', form);
  function deliveryChanged() {
    $("#fixed-delivery-field").hidden = !own.checked;
    fee.required = own.checked;
    fee.disabled = !own.checked;
  }
  own.addEventListener("change", deliveryChanged);
  deliveryChanged();
  function preview() {
    const palette = $<HTMLSelectElement>('[name="palette"]', form)
      .value as StoreAppearance["palette"];
    const font = $<HTMLSelectElement>('[name="font"]', form)
      .value as StoreAppearance["font"];
    const layout = $<HTMLSelectElement>('[name="layout"]', form)
      .value as StoreAppearance["layout"];
    const sample = $("#appearance-preview");
    sample.style.cssText = appearanceStyles({ palette, font, layout });
    sample.dataset.layout = layout;
  }
  form.addEventListener("change", preview);
  preview();
  form.onsubmit = (event) => {
    event.preventDefault();
    void busy($<HTMLButtonElement>('button[type="submit"]', form), async () => {
      const fields = new FormData(form);
      let bannerId: string | null = form.dataset.bannerId || null;
      if (fields.get("remove_banner") === "on") bannerId = null;
      const file = fields.get("banner");
      if (file instanceof File && file.size) {
        const signature = `${file.name}:${file.size}:${file.lastModified}`;
        if (form.dataset.uploadSignature !== signature) {
          form.dataset.uploadId = await upload(
            file,
            "banner",
            $("#panel-app").dataset.csrf!,
          );
          form.dataset.uploadSignature = signature;
        }
        bannerId = form.dataset.uploadId!;
      }
      fields.delete("banner");
      fields.delete("remove_banner");
      await api(
        "painel/loja",
        {
          ...Object.fromEntries(fields),
          delivery_fee: own.checked
            ? Math.round(Number(fields.get("delivery_fee")) * 100)
            : Math.round(Number(fee.value) * 100),
          has_own_delivery: own.checked,
          banner_id: bannerId,
          is_open: fields.get("is_open") === "on",
          version: Number(form.dataset.version),
        },
        "PATCH",
        $("#panel-app").dataset.csrf,
      );
      form.dataset.version = String(Number(form.dataset.version) + 1);
      form.dataset.bannerId = bannerId ?? "";
      feedback("Configurações salvas. A loja já mostra as novas informações.");
    });
  };
</script>
