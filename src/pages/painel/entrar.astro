---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Entrar no painel">
  <div class="wrap page-wrap">
    <div class="compact-page">
      <section class="card login-card">
        <div class="eyebrow">SEU NEGÓCIO, BEM CUIDADO</div>
        <h1>
          Olá, lojista<span class="accent">.</span>
        </h1>
        <p class="small muted">
          Entre para atender os pedidos e cuidar da sua loja.
        </p>
        <div class="auth-switch">
          <button
            class="button button-quiet"
            id="show-login"
            aria-pressed="true"
          >
            Entrar
          </button>
          <button
            class="button button-quiet"
            id="show-register"
            aria-pressed="false"
          >
            Criar minha loja
          </button>
        </div>
        <form id="register-form" hidden>
          <label class="field">
            <span>Nome da nova loja</span>
            <input
              name="title"
              required
              minlength="2"
              maxlength="80"
              placeholder="Ex.: Doces da Vila"
            />
          </label>
          <label class="field">
            <span>E-mail da nova loja</span>
            <input
              type="email"
              name="email"
              required
              maxlength="120"
              autocomplete="username"
              placeholder="minhaloja@exemplo.invalid"
            />
          </label>
          <label class="field">
            <span>Senha para a nova loja</span>
            <input
              type="password"
              name="password"
              required
              minlength="8"
              maxlength="128"
              autocomplete="new-password"
            />
            <small>Use uma senha inventada com pelo menos 8 caracteres.</small>
          </label>
          <label class="checkbox">
            <input type="checkbox" name="syntheticData" required />
            <span>
              Estou criando uma loja de teste com dados e senha fictícios.
            </span>
          </label>
          <button class="button button-primary button-full" type="submit">
            Criar loja e personalizar →
          </button>
          <p id="register-feedback" class="feedback" role="alert"></p>
        </form>
        <form id="login-form">
          <label class="field">
            <span>E-mail de demonstração</span>
            <input
              type="email"
              name="email"
              value="forno@demo.doofi.test"
              required
              autocomplete="username"
            />
          </label>
          <label class="field">
            <span>Senha de demonstração</span>
            <input
              type="password"
              name="password"
              value="demo-doofi-P1!"
              required
              autocomplete="current-password"
            />
          </label>
          <button class="button button-primary button-full" type="submit">
            Entrar no painel →
          </button>
          <p id="feedback" class="feedback" role="alert" aria-live="polite"></p>
        </form>
        <div class="notice">
          Credenciais públicas de teste para uso local ou em demonstração
          protegida. Não utilize uma senha pessoal.
        </div>
        <div class="demo-accounts">
          <button class="demo-account" data-email="forno@demo.doofi.test">
            Loja A · Casa do Forno <span>Usar conta →</span>
          </button>
          <button class="demo-account" data-email="verde@demo.doofi.test">
            Loja B · Verde à Mesa <span>Usar conta →</span>
          </button>
        </div>
        <p class="small muted" style="margin:18px 0 0">
          Recuperação de conta e autenticação de produção fazem parte da P2.
        </p>
      </section>
    </div>
  </div>
</Layout>
<script>
  import { $, api, busy } from "../../scripts/browser";
  const loginForm = $<HTMLFormElement>("#login-form"),
    registerForm = $<HTMLFormElement>("#register-form");
  function showRegister(register: boolean) {
    loginForm.hidden = register;
    registerForm.hidden = !register;
    $("#show-login").setAttribute("aria-pressed", String(!register));
    $("#show-register").setAttribute("aria-pressed", String(register));
    $<HTMLInputElement>("input", register ? registerForm : loginForm).focus();
  }
  $("#show-login").onclick = () => showRegister(false);
  $("#show-register").onclick = () => showRegister(true);
  registerForm.onsubmit = async (event) => {
    event.preventDefault();
    const button = $<HTMLButtonElement>('button[type="submit"]', registerForm);
    button.disabled = true;
    try {
      const fields = new FormData(registerForm);
      const result = await api<{ next: string }>("register", {
        ...Object.fromEntries(fields),
        syntheticData: fields.get("syntheticData") === "on",
      });
      location.assign(result.next);
    } catch (error) {
      $("#register-feedback").textContent = (error as Error).message;
    } finally {
      button.disabled = false;
    }
  };
  document.querySelectorAll<HTMLButtonElement>("[data-email]").forEach(
    (button) =>
      (button.onclick = () => {
        showRegister(false);
        $<HTMLInputElement>('[name="email"]', loginForm).value =
          button.dataset.email!;
        $<HTMLInputElement>('[name="password"]', loginForm).value =
          "demo-doofi-P1!";
        $<HTMLInputElement>('[name="email"]', loginForm).focus();
      }),
  );
  $<HTMLFormElement>("#login-form").onsubmit = (event) => {
    event.preventDefault();
    const form = new FormData(event.currentTarget as HTMLFormElement);
    void busy(
      $<HTMLButtonElement>('#login-form button[type="submit"]'),
      async () => {
        const result = await api<{ next: string }>(
          "login",
          Object.fromEntries(form),
        );
        location.assign(result.next);
      },
    );
  };
</script>
