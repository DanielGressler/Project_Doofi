---
import PanelLayout from "../../../layouts/PanelLayout.astro";
import { env } from "cloudflare:workers";
import { ownedOrderSnapshot } from "../../../lib/orders";
import {
  allowedOrderTransitions,
  fulfillmentAction,
} from "../../../lib/order-workflow";
import {
  money,
  statusLabels,
  paymentLabels,
  formatDate,
} from "../../../lib/types";
import { AppError } from "../../../lib/core";
let detail;
try {
  detail = await ownedOrderSnapshot(
    env.DB,
    Astro.locals.session!,
    Astro.params.id!,
  );
} catch (error) {
  if (error instanceof AppError && error.status === 404) {
    Astro.response.status = 404;
  } else throw error;
}
const order = detail?.order;
const allowed = order ? allowedOrderTransitions(order) : [];
const primary = order ? fulfillmentAction(order) : null;
const initial =
  order && detail
    ? {
        status: order.status,
        version: order.version,
        received_at: order.received_at ?? null,
        fulfillment: order.fulfillment,
        subtotal: order.subtotal,
        delivery_fee: order.delivery_fee,
        total: order.total,
        payment: detail.payment,
        quote: detail.quote,
      }
    : null;
---

<PanelLayout title={order?.protocol ?? "Pedido não encontrado"} active="orders">
  <a class="back-link" href="/painel/pedidos">
    ← Voltar aos pedidos
  </a>
  {!order || !detail ? (
    <div class="empty-state">
      <h1>Pedido não encontrado.</h1>
      <p>Este pedido não está disponível para a sua loja.</p>
    </div>
  ) : (
    <div
      id="order-detail"
      data-id={order.id}
      data-version={order.version}
      data-initial={JSON.stringify(initial)}
    >
      <div class="page-heading">
        <div>
          <div class="eyebrow">
            PEDIDO DE TESTE · {formatDate(order.created_at)}
          </div>
          <h1>{order.protocol}</h1>
          <span
            id="order-status"
            class="badge"
            data-status={order.status}
            role="status"
            aria-live="polite"
          >
            {statusLabels[order.status]}
          </span>
        </div>
        <button class="button button-quiet" id="reload-detail">
          Atualizar dados ↻
        </button>
      </div>
      <div class="detail-layout">
        <div>
          <section class="card">
            <h2>O que vamos preparar?</h2>
            <ul class="summary-list">
              {detail.items.map((i) => (
                <li>
                  <span>
                    {i.quantity} × {i.title}
                    <br />
                    <small class="muted">
                      {money(i.price)} por unidade · preço do pedido
                    </small>
                  </span>
                  <strong>{money(i.price * i.quantity)}</strong>
                </li>
              ))}
            </ul>
            <div class="total-row">
              <span>Produtos</span>
              <strong id="detail-subtotal">{money(order.subtotal)}</strong>
            </div>
            <div class="total-row">
              <span>Entrega</span>
              <strong id="detail-fee">{money(order.delivery_fee)}</strong>
            </div>
            <div class="total-row grand">
              <span>Total do pedido</span>
              <strong id="detail-total">{money(order.total)}</strong>
            </div>
            <div class="detail-section">
              <h3>Comprador fictício</h3>
              <p>
                {order.customer_name}
                <br />
                Telefone:{" "}
                {order.customer_phone ?? "Não informado neste pedido antigo"}
                <br />
                E-mail:{" "}
                {order.customer_email ?? "Não informado neste pedido antigo"}
              </p>
            </div>
            <div class="detail-section">
              <h3>
                {order.fulfillment === "PICKUP"
                  ? "Retirada na loja"
                  : "Entrega pelo vendedor"}
              </h3>
              <p>
                {order.fulfillment === "PICKUP"
                  ? "O comprador retira na loja."
                  : `${order.address}\n${order.neighborhood} · CEP ${order.postal_code}`}
              </p>
            </div>
            {order.note && (
              <div class="detail-section">
                <h3>Observação do comprador</h3>
                <p>{order.note}</p>
              </div>
            )}
          </section>
          <section
            class="card fulfillment-card"
            aria-labelledby="fulfillment-title"
          >
            <h2 id="fulfillment-title">Atendimento</h2>
            <p id="customer-receipt-state" class="small" role="status"></p>
            <p id="fulfillment-help" class="small muted"></p>
            <button
              type="button"
              id="fulfill-order"
              class="button button-primary fulfillment-bar"
              hidden={!primary}
              aria-describedby="fulfillment-help"
              disabled
            >
              {primary?.label ?? "Pedido pronto"}
            </button>
            <button
              type="button"
              id="accept-order"
              class="button button-primary fulfillment-bar"
              hidden={!allowed.includes("ACCEPTED")}
              disabled
            >
              Aceitar pedido
            </button>
            <p
              id="fulfillment-final"
              class="small muted"
              hidden={allowed.length > 0}
            >
              O atendimento chegou a um estado final. O histórico continua
              disponível.
            </p>
            <details
              id="other-order-actions"
              class="secondary-order-actions"
              hidden={
                !allowed.some((status) =>
                  ["REJECTED", "CANCELLED"].includes(status),
                )
              }
            >
              <summary>Outras ações</summary>
              <label class="field">
                <span>Motivo para recusa ou cancelamento</span>
                <input
                  id="transition-reason"
                  minlength="3"
                  maxlength="160"
                  placeholder="Obrigatório para recusar ou cancelar"
                  aria-describedby="reason-error"
                />
              </label>
              <p id="reason-error" class="feedback error" role="alert"></p>
              <div class="actions">
                <button
                  type="button"
                  id="reject-order"
                  class="button button-danger"
                  hidden={!allowed.includes("REJECTED")}
                  disabled
                >
                  Recusar pedido
                </button>
                <button
                  type="button"
                  id="cancel-order"
                  class="button button-danger"
                  hidden={!allowed.includes("CANCELLED")}
                  disabled
                >
                  Cancelar pedido
                </button>
              </div>
            </details>
          </section>
          <dialog
            id="delivery-confirmation"
            class="ui-dialog"
            aria-labelledby="delivery-confirmation-title"
            aria-describedby="delivery-confirmation-description"
          >
            <div class="dialog-heading">
              <h2 id="delivery-confirmation-title">
                Confirmar entrega do pedido?
              </h2>
            </div>
            <p id="delivery-confirmation-description">
              Confirme somente depois de entregar o pedido ao cliente. Nesta
              fase, a confirmação é manual pelo lojista.
            </p>
            <p
              id="delivery-confirmation-error"
              class="feedback error"
              role="alert"
            ></p>
            <div class="actions">
              <button
                type="button"
                class="button button-quiet"
                id="close-delivery-confirmation"
                autofocus
              >
                Voltar
              </button>
              <button
                type="button"
                class="button button-primary"
                id="confirm-delivery"
              >
                Confirmar entrega
              </button>
            </div>
          </dialog>
          {order.fulfillment === "QUOTE" && (
            <section class="card">
              <h2>Proposta de entrega</h2>
              <p id="quote-info" class="small muted" hidden={!detail.quote}></p>
              <form
                id="quote-form"
                method="post"
                hidden={
                  !["QUOTE_PENDING", "QUOTE_PROPOSED"].includes(order.status)
                }
              >
                <div class="form-grid">
                  <label class="field">
                    <span>Frete (R$)</span>
                    <input
                      type="number"
                      name="fee"
                      min="0"
                      max="1000"
                      step="0.01"
                      value="9.00"
                      required
                    />
                  </label>
                  <label class="field">
                    <span>Validade (minutos)</span>
                    <input
                      type="number"
                      name="validMinutes"
                      min="1"
                      max="1440"
                      value="30"
                      required
                    />
                  </label>
                  <label class="field full">
                    <span>Prazo estimado</span>
                    <input
                      name="estimate"
                      value="Até 45 minutos após o aceite"
                      minlength="3"
                      maxlength="100"
                      required
                    />
                  </label>
                </div>
                <button
                  class="button button-primary"
                  type="submit"
                  style="margin-top:18px"
                >
                  Enviar proposta de frete
                </button>
              </form>
            </section>
          )}
          <details class="card transaction-log" id="transaction-log">
            <summary>
              <span>Histórico de transações</span>
              <small id="audit-count">Abrir histórico</small>
            </summary>
            <p class="small muted">
              Eventos deste pedido. Exibimos os 100 mais recentes; o registro
              completo é preservado.
            </p>
            <ul id="audit-list" class="audit-list"></ul>
            <p id="audit-feedback" class="feedback error" role="alert"></p>
            <button
              type="button"
              id="retry-audit"
              class="button button-quiet"
              hidden
            >
              Tentar carregar histórico novamente
            </button>
          </details>
        </div>
        <aside class="card">
          <h2>Pagamento simulado</h2>
          <p class="small">
            {detail.payment.method === "PIX_SIMULATED"
              ? "Pix demonstrativo"
              : "Na retirada ou entrega · demonstração"}
          </p>
          <p class="notice" id="payment-state">
            {paymentLabels[detail.payment.status]}
            <br />
            Nenhuma transferência ou confirmação bancária.
          </p>
          <button
            type="button"
            class="button button-quiet button-full"
            id="confirm-payment"
            hidden={
              order.total === null ||
              ![
                "ACCEPTED",
                "PREPARING",
                "READY",
                "OUT_FOR_DELIVERY",
                "COMPLETED",
              ].includes(order.status) ||
              detail.payment.status === "SIMULATED_SELLER_CONFIRMED"
            }
            disabled
          >
            Simular conferência do lojista
          </button>
          <p class="small muted">
            A declaração do comprador não equivale à conferência do lojista. Na
            P1, ambas são apenas eventos simulados.
          </p>
        </aside>
      </div>
      <p id="feedback" class="feedback" role="alert" aria-live="polite"></p>
    </div>
  )}
</PanelLayout>
<script>
  import "../../../scripts/order-detail";
</script>
