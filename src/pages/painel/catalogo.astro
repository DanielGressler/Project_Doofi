---
import PanelLayout from "../../layouts/PanelLayout.astro";
import type { Store } from "../../lib/types";
import NovelGuide from "../../components/NovelGuide.astro";
import { catalogGuide as scenes } from "../../lib/guide-scenes";
import ProductEditor from "../../components/ProductEditor.astro";
import { env } from "cloudflare:workers";
import { getProducts } from "../../lib/catalog";
const [products, store] = await Promise.all([
  getProducts(env.DB, Astro.locals.session!.store_id),
  env.DB.prepare(
    "SELECT setup_complete,version,palette,font,layout FROM stores WHERE id=?",
  )
    .bind(Astro.locals.session!.store_id)
    .first<
      Pick<Store, "setup_complete" | "version" | "palette" | "font" | "layout">
    >(),
]);
const tutorial =
  Astro.locals.session!.role === "owner" &&
  (Astro.url.searchParams.get("tutorial") === "1" || !store!.setup_complete);
const chapter = Math.min(
  scenes.length - 1,
  Math.max(0, Math.floor(Number(Astro.url.searchParams.get("capitulo")) || 0)),
);
---

<PanelLayout title="Catálogo" active="catalog" appearance={store!}>
  <div class="page-heading">
    <div>
      <div class="eyebrow">O QUE SUA LOJA FAZ DE BOM</div>
      <h1>
        Seu cardápio<span class="accent">.</span>
      </h1>
      <p>Produtos e combos organizados por categoria.</p>
    </div>
    <div class="editor-actions">
      <button class="button button-primary" data-open-dialog="product-dialog">
        + Novo produto
      </button>
      <button class="button button-quiet" data-open-dialog="combo-dialog">
        + Novo combo
      </button>
    </div>
  </div>
  {tutorial && (
    <div data-guide-version={store!.version} id="catalog-tutorial">
      <NovelGuide
        id="catalog-guide"
        scenes={scenes}
        controls
        floating
        skip
        chapter={chapter}
      />
    </div>
  )}
  <p class="notice">
    Use o botão + ao lado do nome para abrir os detalhes e editar; − minimiza o
    cartão. As alterações valem para novos pedidos. Deixe a caixa de
    indisponibilidade desmarcada para vender. Nos combos, a indisponibilidade de
    um dos itens bloqueia o anúncio automaticamente.
  </p>
  <datalist id="category-examples">
    {[
      "Doces",
      "Bebidas",
      "Pratos principais",
      "Petiscos",
      "Lanches",
      "Combos",
    ].map((category) => (
      <option value={category} />
    ))}
  </datalist>
  {[false, true].map((combo) => (
    <section
      class="catalog-section"
      aria-labelledby={combo ? "combos-title" : "products-title"}
    >
      <h2 id={combo ? "combos-title" : "products-title"}>
        {combo ? "Combos" : "Produtos individuais"}{" "}
        <span class="muted small">
          ({products.filter((p) => !!p.is_combo === combo).length})
        </span>
      </h2>
      <div class="product-editor compact-catalog">
        {products
          .filter((p) => !!p.is_combo === combo)
          .map((product) => (
            <article class="catalog-card">
              <div class="catalog-card-heading">
                <h3>{product.title}</h3>
                <button
                  type="button"
                  class="catalog-toggle"
                  data-product-toggle={product.title}
                  aria-expanded="false"
                  aria-controls={`editor-${product.id}`}
                  aria-label={`Mais detalhes de ${product.title}`}
                >
                  +
                </button>
              </div>
              <div id={`editor-${product.id}`} hidden>
                <ProductEditor product={product} products={products} />
              </div>
            </article>
          ))}
      </div>
      {!products.some((p) => !!p.is_combo === combo) && (
        <p class="muted small">
          {combo
            ? "Crie um combo reunindo dois produtos da sua loja."
            : "Seu primeiro produto aparecerá aqui."}
        </p>
      )}
    </section>
  ))}
  {[false, true].map((combo) => (
    <dialog
      class="ui-dialog editor-dialog"
      id={combo ? "combo-dialog" : "product-dialog"}
      aria-labelledby={combo ? "new-combo-title" : "new-product-title"}
    >
      <div class="dialog-heading">
        <h2 id={combo ? "new-combo-title" : "new-product-title"}>
          {combo ? "Criar combo" : "Criar produto"}
        </h2>
        <button
          type="button"
          class="button button-quiet"
          data-close-dialog
          aria-label="Fechar criação"
        >
          Fechar ×
        </button>
      </div>
      <ProductEditor products={products} combo={combo} />
    </dialog>
  ))}
  <p id="feedback" class="feedback" role="alert"></p>
</PanelLayout>
<script>
  import "../../scripts/dialogs";
  import "../../scripts/catalog-cards";
  import { $, api, busy } from "../../scripts/browser";
  $("#catalog-guide [data-guide-skip]")?.addEventListener("click", (event) => {
    void busy(event.currentTarget as HTMLButtonElement, async () => {
      try {
        await api(
          "painel/guia/concluir",
          {
            version: Number($("#catalog-tutorial").dataset.guideVersion),
            skip: true,
          },
          "POST",
          $("#panel-app").dataset.csrf,
        );
        $("#catalog-guide").dispatchEvent(new Event("guide:hide"));
        $("#catalog-tutorial").hidden = true;
        const url = new URL(location.href);
        url.searchParams.delete("tutorial");
        url.searchParams.delete("capitulo");
        history.replaceState(null, "", url);
        const focus =
          document.querySelector<HTMLElement>(".editor-dialog[open] input") ??
          $("h1");
        focus.tabIndex = focus.matches("h1") ? -1 : focus.tabIndex;
        focus.focus();
        $("#feedback").textContent =
          "Tutorial pulado. Seus produtos continuam disponíveis para edição. Você pode reabrir o guia pelo rodapé.";
      } catch (error) {
        $("#catalog-guide [data-guide-feedback]").textContent = (
          error as Error
        ).message;
      }
    });
  });
  $("[data-guide-finish]")?.addEventListener("click", (event) => {
    void busy(event.currentTarget as HTMLButtonElement, async () => {
      try {
        await api(
          "painel/guia/concluir",
          { version: Number($("#catalog-tutorial").dataset.guideVersion) },
          "POST",
          $("#panel-app").dataset.csrf,
        );
        location.assign("/painel/pedidos");
      } catch (error) {
        $("#catalog-guide [data-guide-feedback]").textContent = (
          error as Error
        ).message;
      }
    });
  });
  import "../../scripts/catalog-editor";
</script>
